# Slack App 与准入范围。白名单支持 all；黑名单优先于白名单。
# 必填：接收事件的 Slack App 的 Signing Secret，用于校验请求签名。
SLACK_SIGNING_SECRET=
# 必填：允许接收事件的 Slack 工作区 ID（T 开头）。
SLACK_TEAM_ID=
# 必填：Review owner User ID；本人只 @目标组且未直接 @自己时静默忽略。
RELAY_OWNER_SLACK_USER_ID=
# 与下方用户组配置至少填一项：被 @ 的用户 ID，多个 ID 用英文逗号分隔。
SLACK_TARGET_USER_IDS=
# 与上方用户配置至少填一项：被 @ 的 User Group ID，多个 ID 用英文逗号分隔。
SLACK_TARGET_SUBTEAM_IDS=
# 可选：取消关键词，英文逗号分隔；空值默认 cancel,取消。自定义非空列表替换默认值。
# 仅 SLACK_TARGET_USER_IDS 中的用户发送目标 mention + 完整关键词才能取消。
SLACK_CANCEL_KEYWORDS=cancel,取消
# 必填：允许的频道 ID；显式 all 表示允许所有频道，空值拒绝启动。
SLACK_ALLOWED_CHANNEL_IDS=
# 可选：禁止的频道 ID，英文逗号分隔；留空表示无黑名单，命中时优先拒绝。
SLACK_BLOCKED_CHANNEL_IDS=
# 可选：允许发送触发消息的用户 ID，英文逗号分隔；all 或留空表示不限制发送者。
SLACK_ALLOWED_SENDER_IDS=all
# 可选：禁止发送触发消息的用户 ID，英文逗号分隔；留空表示无黑名单，命中时优先拒绝。
SLACK_BLOCKED_SENDER_IDS=
# 可选的一组完整配置：监听可信 GitHub Actions App 的发布候选通知并交给 Agent 直接批准“版本 PR”。
# 三项必须同时配置；全部留空时关闭功能，只配置部分会拒绝启动。
SLACK_RELEASE_APPROVAL_CHANNEL_ID=
SLACK_RELEASE_APPROVAL_APP_ID=
SLACK_RELEASE_APPROVAL_BOT_ID=
# 可选：保留给与 PR Review reaction 无关的其他功能；Relay 不会用它添加或清理 Review reaction。
SLACK_BOT_TOKEN=
# 必填：取消后读取并清理本人 reaction 的 USER token；必须与 Agent 的 Slack User 身份相同。
# 需要 reactions:read、reactions:write 且能访问目标频道。Relay 不负责添加 eyes。
SLACK_USER_TOKEN=

# 普通 Multica Issue API；无需 Autopilot 或 Webhook。
# 必填：Multica 服务的 HTTPS 基础地址，替换示例域名；不附加 /api 路径。
MULTICA_API_BASE_URL=https://multica.example.com
# 必填：访问目标 Multica 工作区、项目与 Agent 的 API token。
MULTICA_API_TOKEN=
# 必填：目标 Multica 工作区的完整 ID。
MULTICA_WORKSPACE_ID=
# 必填：接收任务的 Multica 项目完整 ID，须属于上述工作区。
MULTICA_PROJECT_ID=
# 兼容旧版：Agent 模式未填写 MULTICA_ASSIGNEE_ID 时必填；须为上述工作区的 Agent 完整 ID。
# Team 模式不使用此项，改填下方 TYPE/ID。
MULTICA_AGENT_ID=
# 可选：agent（默认）或 squad（Team）。
MULTICA_ASSIGNEE_TYPE=agent
# squad 模式必填 Team 完整 ID；agent 模式可填 Agent 完整 ID，优先于旧版配置。
MULTICA_ASSIGNEE_ID=
# 已有项目迁移时固定为旧 MULTICA_AGENT_ID，永久保留，防止重复建卡。
MULTICA_THREAD_SCOPE_ID=
# 迁移过渡期允许原 Agent 归属；必须与 THREAD_SCOPE_ID 一致。
MULTICA_LEGACY_AGENT_ID=

# 启用单 Agent 收口接口时必填：/api/multica/ignore 的独立随机 Bearer token。
# Vercel 与 Slack Task Router Agent 配置相同值；不得复用 Multica API token。
RELAY_IGNORE_TOKEN=
# 仅配置到 Slack Task Router Agent：本部署公开的准确 HTTPS 收口地址。
# RELAY_IGNORE_URL=https://relay.example.com/api/multica/ignore


# 本项目专用 Redis：线程映射和写入确认状态，默认保留90天。
# 以下两项均必填：Upstash Redis 的 HTTPS REST 地址（不是 redis:// 连接串）及具有读写权限的 REST API token。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# QStash：持久化收件、后台投递、重试与失败保留。
# 服务地址可选，留空使用下方默认值；发布消息的 token、用于消费请求验签的 current/next 两把签名密钥均必填。
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# 必填：当前部署公开的准确 HTTPS 消费 URL，供发送和验签共同使用。
# 替换示例域名，保留 /api/queue/consume 路径；不添加查询参数或片段。
RELAY_CONSUMER_URL=https://relay.example.com/api/queue/consume
